# ============================================================
# 后端环境变量配置文件（模板）
# 第一次启动时，把本文件复制一份命名为 .env，系统才会读取
# 命令：cp .env.example .env   （Windows：copy .env.example .env）
# ============================================================

# 后端服务监听的端口号，浏览器通过这个端口访问后端
PORT=3000

# ============================================================
# 数据库模式一：懒人模式（新手推荐，无需安装 MySQL）
# 数据保存在本地文件里，注释掉下面这行前面的 # 就启用
# ============================================================
DB_DIALECT=sqlite

# ============================================================
# 数据库模式二：完整 MySQL 模式（课程作业要求）
# 需要本机已安装并启动 MySQL 8，把下面每行前面的 # 去掉并填自己的密码
# ============================================================
# DB_DIALECT=mysql
# DB_HOST=127.0.0.1        # MySQL 服务器地址，本机就是 127.0.0.1
# DB_PORT=3306             # MySQL 默认端口 3306
# DB_NAME=classroom_monitor # 数据库名，需要先在 MySQL 里手动 CREATE DATABASE
# DB_USER=root             # 数据库用户名
# DB_PASSWORD=your_mysql_password  # 改成你自己的 MySQL root 密码

# JWT 登录令牌的加密密钥，随便填一串字符就行；
# 它用来给登录后发的 token "签名"，防止别人伪造登录态。上线前务必改成随机长字符串
JWT_SECRET=dev_secret_change_me_please

# 登录令牌的有效期：7 天，意思是登录后 7 天内不用重新登录
JWT_EXPIRES_IN=7d
