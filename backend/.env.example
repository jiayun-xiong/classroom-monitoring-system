# ============================================================
# 后端环境变量配置
# 第一步：复制本文件为 .env（cp .env.example .env）
# 第二步：按下面说明选一种数据库模式，改对应那一段即可
# ============================================================

# 服务端口
PORT=3000

# ============================================================
# 模式一：懒人模式（推荐新手使用，无需安装 MySQL）
# 数据保存在本地文件里，开箱即用。
# 把下一行的注释去掉（删掉 # 和空格），并把模式二整段注释掉：
# ============================================================
DB_DIALECT=sqlite

# ============================================================
# 模式二：完整 MySQL 模式（课程作业要求）
# 需要本机已安装并启动 MySQL 8，填入你的 MySQL 账号密码。
# 如果使用模式一，请把下面这一整段注释掉（每行前面加 #）。
# ============================================================
# DB_DIALECT=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=classroom_monitor
# DB_USER=root
# DB_PASSWORD=your_mysql_password

# JWT 密钥（开发阶段使用，随便填一串字符即可；上线前必须更换）
JWT_SECRET=dev_secret_change_me_please
JWT_EXPIRES_IN=7d
